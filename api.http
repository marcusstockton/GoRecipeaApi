### Health check
GET http://localhost:8080/
Accept: application/json

### List all chefs
GET http://localhost:8080/chef
Accept: application/json

### Get chef by ID
GET http://localhost:8080/chef/1
Accept: application/json

### Register a chef
POST http://localhost:8080/chef
Content-Type: application/json

{
  "first_name": "Martha",
  "last_name": "Stewart",
  "email": "martha@stewart.com",
  "password": "TastySnacks2026"
}

### Login chef
POST http://localhost:8080/chef/login
Content-Type: application/json

{
  "email": "martha@stewart.com",
  "password": "TastySnacks2026"
}

### Validate JWT token
GET http://localhost:8080/chef/validate
Authorization: Bearer {{jwt_token}}
Accept: application/json

### Update chef
PUT http://localhost:8080/chef/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "first_name": "Gordon",
  "last_name": "Ramsay",
  "email": "gordon@example.com",
  "password": "newPassword123"
}

### List all recipes
GET http://localhost:8080/recipe
Accept: application/json

### Get recipe by ID
GET http://localhost:8080/recipe/1
Accept: application/json

### Create a recipe
POST http://localhost:8080/recipe
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "title": "Spaghetti aglio e olio",
  "description": "classic Italian pasta dish originating from Naples, Italy, translating literally to \"garlic and oil.\" It is a quintessential example of cucina povera (poor cooking), relying on simple, pantry-staple ingredients to create a rich, aromatic meal.",
  "ingredients": [
    {
      "quantity": "1",
      "unit": "pound",
      "name": "spaghetti"
    },
    {
      "quantity": "1",
      "unit": "cup",
      "name": "garlic"
    },
    {
      "quantity": "1",
      "unit": "1/2 cup",
      "name": "olive oil"
    },
    {
      "quantity": "1",
      "unit": "1 tsp",
      "name": "red pepper flakes"
    },
    {
      "quantity": "1",
      "unit": "to taste",
      "name": "salt"
    },
    {
      "quantity": "1",
      "unit": "to taste",
      "name": "black pepper"
    },
    {
      "quantity": "1",
      "unit": "bunch",
      "name": "fresh parsley, chopped"
    }
  ],
  "steps": [
    {
      "order": 1,
      "action": "Gather all the ingredients."
    },
    {
      "order": 2,
      "action": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally until cooked through but firm to the bite, about 10 to 12 minutes. Drain and transfer to a pasta bowl."
    },
    {
      "order": 3,
      "action": "While the pasta is cooking, heat olive oil in a large skillet over medium heat. Add garlic and red pepper flakes, and sauté until the garlic is golden brown, about 2 minutes."
    },
    {
      "order": 4,
      "action": "Pour the garlic and oil mixture over the cooked spaghetti. Toss to coat the pasta evenly."
    },
    {
      "order": 5,
      "action": "Season with salt and black pepper to taste. Sprinkle with chopped fresh parsley before serving."
    }
  ]
}

### Update a recipe
PUT http://localhost:8080/recipe/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "title": "Chocolate Cake",
  "description": "A delicious homemade chocolate cake",
  "ingredients": [
    {
      "quantity": "2",
      "unit": "cups",
      "name": "flour",
      "preparation": "sifted"
    },
    {
      "quantity": "1",
      "unit": "cup",
      "name": "sugar"
    }
  ],
  "steps": [
    {
      "order": 1,
      "action": "Preheat oven to 350°F"
    },
    {
      "order": 2,
      "action": "Mix dry ingredients in a bowl"
    }
  ]
}

### Delete a recipe
DELETE http://localhost:8080/recipe/1
Authorization: Bearer {{jwt_token}}

### Like a recipe
POST http://localhost:8080/recipe/1/like
Authorization: Bearer {{jwt_token}}
Accept: application/json

### Remove your like from a recipe
DELETE http://localhost:8080/recipe/1/like
Authorization: Bearer {{jwt_token}}
Accept: application/json

### Add a comment to a recipe
POST http://localhost:8080/recipe/1/comment
Content-Type: application/json
Authorization: Bearer {{jwt_token}}
Accept: application/json

{
  "content": "This recipe looks amazing!"
}

### Reply to a comment
POST http://localhost:8080/recipe/1/comment
Content-Type: application/json
Authorization: Bearer {{jwt_token}}
Accept: application/json

{
  "content": "Thanks, I appreciate the feedback!",
  "parent_id": 1
}

### List comments for a recipe
GET http://localhost:8080/recipe/1/comments
Accept: application/json

### Delete your comment from a recipe
DELETE http://localhost:8080/comment/1
Authorization: Bearer {{jwt_token}}
Accept: application/json
